{
  // ── Configurația Worker-ului (backend + site public) ──────────────────────
  "name": "vanzariautopark",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // ── Fișiere statice ───────────────────────────────────────────────────────
  //  ⚠️ IMPORTANT: Cloudflare servește fișierele din `directory` ÎNAINTE de
  //  Worker. Dacă există `public/index.html`, el e servit la `/` și Worker-ul
  //  nu mai e apelat — pagina de acasă nu apare niciodată.
  //
  //  În `public/` trebuie să existe DOAR folderul `assets/` cu imaginile:
  //    logo.png, landing1-5.jpeg, g1-8.jpeg, tbi_banner.png, tbi_logo.png
  //
  //  `not_found_handling: "none"` = orice cale care nu e fișier real cade la
  //  Worker (exact ce vrem: toate paginile sunt randate de Hono).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // ── D1 (baza de date) ──
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autopark_db",
      "database_id": "ac784e2c-1d83-4dae-993b-8318e644d113"
    }
  ],

  // ── Cron Triggers ────────────────────────────────────────────────────────
  //  Cloudflare apelează automat export-ul `scheduled` din src/index.js la
  //  orele de mai jos — nu ai nevoie de niciun server sau serviciu separat.
  //  "0 3 * * *" = 03:00 UTC zilnic (06:00 ora României, vara). Rulează
  //  sweepOrphanedMedia() din src/lib/sweep.js.
  //
  //  "15 11 * * *" = TEMPORAR, DOAR PENTRU TEST — 11:15 UTC = 14:15 ora
  //  României. Șterge linia asta după ce confirmi că sweep-ul merge, altfel
  //  rulează în fiecare zi la ora asta pe termen nelimitat.
  "triggers": {
    "crons": ["0 3 * * *"]
  },

  // ── Variabile publice (nu secrete) ──
  "vars": {
    "NODE_ENV": "production",
    "B2_ENDPOINT": "https://s3.eu-central-003.backblazeb2.com",
    "B2_BUCKET_NAME": "vanzariautopark-media",
    // Domeniul public al site-ului: apare în canonical, og:image (previzualizarea
    // linkurilor pe WhatsApp/Facebook), JSON-LD și sitemap. Schimbă-l aici dacă
    // site-ul se mută pe alt domeniu.
    "SITE_DOMAIN": "vanzariautopark.com"
  }

  // Secretele (ADMIN_PASSWORD, ADMIN_ORIGIN, B2_ACCESS_KEY_ID,
  // B2_SECRET_ACCESS_KEY) se pun cu `wrangler secret put`, NU aici.
}
